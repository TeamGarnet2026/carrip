# Supabase（Dashboard → Project Settings → API から取得）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Cloud（Console → APIとサービス → 認証情報 から取得）
# Places / Routes / Maps JavaScript API などに使用（マップ表示も同じキーを流用）
GOOGLE_CLOUD_API_KEY=

# 任意: マップ表示専用キーを使う場合のみ設定（未設定時は GOOGLE_CLOUD_API_KEY を使用）
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Gemini（Google AI Studio から取得。サーバー専用）
GEMINI_API_KEY=
# 任意: 省略時 gemini-2.5-flash-lite（無料枠 0 の gemini-2.0-flash は使わない）
# GEMINI_MODEL=gemini-3.1-flash-lite

# NAVITIME Route(car) via RapidAPI（サーバー専用）
RAPIDAPI_KEY=
RAPIDAPI_HOST=navitime-route-car.p.rapidapi.com

# Upstash Redis（https://console.upstash.com/ から取得。サーバー専用）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 資源エネルギー庁 / 石油情報センター 週次ガソリン価格バッチ用（任意）
# 未設定時は石油情報センターの累積週次 Excel を使用
# ENECHO_WEEKLY_EXCEL_URL=https://oil-info.ieej.or.jp/price/data/SekiyuWeekly.xls
# バッチ書き込み用（GitHub Actions / ローカル sync）
# SUPABASE_SERVICE_ROLE_KEY=

# 任意: 独自の政府燃料価格API（未設定時は DB → 月次フォールバック → 175円）
# GOVERNMENT_FUEL_API_URL=

# ルート検索キャッシュ TTL（秒）。省略時 604800（7日）
ROUTE_CACHE_TTL_SECONDS=
